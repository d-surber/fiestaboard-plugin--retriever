{
  "id": "retriever",
  "name": "Retriever",
  "version": "1.0.0",
  "description": "Shows values retrieved from a companion server. Under construction.",
  "author": "d-surber",
  "icon": "puzzle",
  "category": "utility",
  "repository": "https://github.com/d-surber/fiestaboard-plugin--retriever",
  "documentation": "README.md",

  "min_refresh_seconds": 60,

  "settings_schema": {
    "type": "object",
    "properties": {
      "server_url": {
        "type": "string",
        "title": "Server URL",
        "description": "Base URL of the Retriever server, e.g. http://192.0.2.10:42511. Use an IP address if the name does not resolve."
      },
      "key": {
        "type": "string",
        "title": "Key",
        "description": "The key the server was installed with: base64 of 32 bytes.",
        "ui:widget": "password"
      },
      "values": {
        "type": "array",
        "title": "Values",
        "description": "Name your own values, each defined by an expression over the server's data, such as UPPER(retriever.reminders.data.items[0].title). A name with a parameter in brackets, such as todo[x].what, defines a list: in the definition [x] indexes a list and x alone is the position, counting from 0. Parameters nest, as in lists[x].items[y].what.",
        "ui:widget": "json-path-mapper",
        "ui:options": {
          "preview": "plugin",
          "keys": {"variable": "variable", "path": "definition", "default": "default"}
        },
        "items": {
          "type": "object",
          "properties": {
            "variable": {"type": "string", "title": "Variable Name"},
            "definition": {"type": "string", "title": "Definition"},
            "default": {"type": "string", "title": "Default Value", "default": ""}
          },
          "required": ["variable", "definition"]
        },
        "default": []
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "description": "How often to fetch new data.",
        "default": 300,
        "minimum": 60
      },
      "enabled": {
        "type": "boolean",
        "title": "Enabled",
        "default": false
      }
    },
    "required": ["server_url", "key"]
  },

  "demo": {
    "flagship": {
      "name": "Retriever Demo",
      "template": [
        "Reminders: {{retriever.reminders.data.count}}",
        "{{retriever.error}}{{retriever.reminders.error}}",
        "",
        "{{= IFERROR(retriever.reminders.data.items.0.title, \"\") }}",
        "{{= IFERROR(retriever.reminders.data.items.1.title, \"\") }}",
        ""
      ],
      "line_metadata": [
        {"alignment": "center", "wrap": false},
        {"alignment": "center", "wrap": false},
        {"alignment": "center", "wrap": false},
        {"alignment": "left", "wrap": false},
        {"alignment": "left", "wrap": false},
        {"alignment": "left", "wrap": false}
      ]
    },
    "note": {
      "name": "Retriever (Note)",
      "template": [
        "REMINDERS: {{retriever.reminders.data.count}}",
        "{{retriever.error}}{{retriever.reminders.error}}",
        "{{= IFERROR(retriever.reminders.data.items.0.title, \"\") }}"
      ],
      "line_metadata": [
        {"alignment": "left", "wrap": false},
        {"alignment": "left", "wrap": false},
        {"alignment": "left", "wrap": false}
      ]
    }
  },

  "teaser": "REMINDERS: 2",

  "previews": [
    {
      "device_type": "flagship",
      "rows": [
        "     Reminders: 2",
        "",
        "",
        "Water plants",
        "Call dentist",
        ""
      ]
    },
    {
      "device_type": "note",
      "rows": [
        "REMINDERS: 2",
        "",
        "Water plants"
      ]
    }
  ]
}
